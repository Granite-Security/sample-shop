# Copy this file to secrets-patch.yaml (gitignored, same as k8s/base/secrets.yaml)
# and fill in real production values. It's applied as a patch on top of the
# granite-secrets Secret from k8s/base, so it only needs to list the keys you want
# to override.
#
# Same secret keys as app/secrets-patch.yaml.example and
# app-chocolate/secrets-patch.yaml.example — same backend, same database, same
# Stripe account, same Google OAuth client, now just serving both domains.
#
# Generate strong DB passwords with: openssl rand -base64 32
#
# oidc-client-secret-encoded uses Spring's {noop} prefix in k8s/base, meaning it's
# compared in plaintext — fine for a local kind cluster, not for production. Generate
# a real bcrypt hash instead (e.g. via `htpasswd -bnBC 10 "" '<secret>' | tr -d ':\n'`
# or Spring's BCryptPasswordEncoder) and prefix it with {bcrypt} here.
#
# stripe-* keys: use live keys (sk_live_/pk_live_) only when you're ready to accept
# real payments; otherwise keep test keys and register a webhook endpoint per
# domain that needs one in the Stripe dashboard to get a matching
# stripe-webhook-secret (e.g. https://granite-security.org/api/payments/webhook).
# That path is the one payment actually serves (PaymentRoute.java); events to
# subscribe are payment_intent.succeeded, payment_intent.payment_failed and
# payment_intent.canceled — WebhookHandler ignores every other type.
#
# google-client-id/secret: register BOTH
# https://granite-security.org/login/oauth2/code/google AND
# https://sichocolate.com/login/oauth2/code/google as authorized redirect URIs
# on this OAuth client in Google Cloud Console before switching traffic over —
# auth-server's Google ClientRegistration uses {baseUrl}/login/oauth2/code/google
# by default (request-derived, same mechanism as the issuer), so no per-domain
# secret is needed here, just both URIs registered on the one Google client.
apiVersion: v1
kind: Secret
metadata:
  name: granite-secrets
type: Opaque
stringData:
  db-postgres-password: "CHANGE_ME"
  db-myuser-password: "CHANGE_ME"
  oidc-client-secret-plain: "CHANGE_ME"
  oidc-client-secret-encoded: "{bcrypt}CHANGE_ME"
  google-client-id: "CHANGE_ME.apps.googleusercontent.com"
  google-client-secret: "CHANGE_ME"
  stripe-publishable-key: "pk_live_CHANGE_ME"
  stripe-secret-key: "sk_live_CHANGE_ME"
  stripe-webhook-secret: "whsec_CHANGE_ME"
  # Generate with: openssl rand -hex 32
  garage-rpc-secret: "CHANGE_ME"
  # Bootstrapped once via `garage key create` against the running pod (see
  # docs/plans/storage.md step 8 runbook) — paste the output here, then
  # re-apply this secret.
  storage-s3-access-key: "CHANGE_ME"
  storage-s3-secret-key: "CHANGE_ME"
  # Generate with: openssl rand -hex 32
  garage-admin-token: "CHANGE_ME"
  # garage-webui login gate, format "username:bcrypt_hash" — generate with
  # `htpasswd -bnBC 10 "" '<password>' | tr -d ':\n'`.
  garage-webui-auth-user-pass: "admin:CHANGE_ME_BCRYPT_HASH"
  # Optional — leave blank to keep password-changed emails disabled (profile
  # logs and no-ops instead of sending). Requires the Resend sending domain
  # to be verified first, see docs/users/user-profile.md Phase 4.
  resend-api-key: ""
  # PayPal REST app credentials from developer.paypal.com. Sandbox and live are
  # different apps with different credentials; set PAYPAL_ENV in granite-config to
  # match, since the base URL is never inferred from the key.
  paypal-client-id: "CHANGE_ME"
  paypal-client-secret: "CHANGE_ME"
  # The webhook subscription's id (not a signing secret) — required to verify a
  # delivery. Leave blank to keep PAYMENT_PROVIDER_PAYPAL_WEBHOOK_ENABLED off.
  paypal-webhook-id: ""
