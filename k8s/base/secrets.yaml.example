apiVersion: v1
kind: Secret
metadata:
  name: granite-secrets
type: Opaque
stringData:
  db-postgres-password: "postgres"
  db-myuser-password: "secret"
  oidc-client-secret-plain: "secret"
  oidc-client-secret-encoded: "{noop}secret"
  # Optional — leave blank to skip Stripe checkout / Google login, the rest of the
  # app (catalog, orders, profile, delivery) works without them.
  stripe-webhook-secret: ""
  google-client-id: ""
  google-client-secret: ""
  stripe-publishable-key: ""
  stripe-secret-key: ""
  # Garage's inter-node RPC auth secret (any random 64-hex string; generate with
  # `openssl rand -hex 32`). Not an S3 credential — used only between Garage
  # nodes, but still must not be the throwaway local-dev value.
  garage-rpc-secret: "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
  # S3 credentials for the storage service's app key. Bootstrapped once via
  # `garage key create` against the running pod (see docs/plans/storage.md
  # step 8 runbook) — paste the output here, then re-apply this secret.
  storage-s3-access-key: ""
  storage-s3-secret-key: ""
  # Garage admin API token (any random string; generate with
  # `openssl rand -hex 32`) — consumed by Garage itself (GARAGE_ADMIN_TOKEN)
  # and by the garage-webui dashboard (garage-webui.yaml) to call that API.
  garage-admin-token: "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
  # garage-webui's own login gate, format "username:bcrypt_hash" — generate
  # the hash with `htpasswd -bnBC 10 "" '<password>' | tr -d ':\n'`, same
  # approach as oidc-client-secret-encoded above.
  garage-webui-auth-user-pass: "admin:CHANGE_ME_BCRYPT_HASH"
